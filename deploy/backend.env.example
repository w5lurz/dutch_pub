# Template for deploy/backend.env on the server:  cp backend.env.example backend.env && nano backend.env && chmod 600 backend.env
# The backend's settings (all options: backend/.env.example). The database connection and the
# proxy setting come from docker-compose.prod.yml. Never commit this file.
# Generate a secret with:  openssl rand -hex 32

JWT_SECRET=
# Links in emails (password reset) point here: https:// + DOMAIN from deploy/.env.
PUBLIC_URL=https://yourname.duckdns.org
# Rooms at once (~1.2 MB each): the free VM has plenty of RAM.
MAX_ROOMS=800
# Apps older than this must update first. Leave it empty until a release needs it (MAINTENANCE.md).
MIN_APP_VERSION=
# Password reset emails (Gmail with an app password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dutch Pub <address@gmail.com>"
# Shown in the privacy policy (/privacy).
PRIVACY_CONTACT=
PRIVACY_OWNER=
