# Template for deploy/.env on the server:  cp env.prod.example .env && nano .env && chmod 600 .env
# Server-level settings: Docker Compose, backup.sh and duckdns.sh read them. The backend's own
# settings are in deploy/backend.env (backend.env.example). Never commit either file.
# Generate each secret with:  openssl rand -hex 32

# The server's name (without https://). Caddy gets the HTTPS certificate for it. Several names (an own
# domain plus the old DuckDNS one while older apps still use it): comma-separated and quoted, e.g.
# DOMAIN="dutchpub.eu, yourname.duckdns.org"
DOMAIN=yourname.duckdns.org
# The web version of the app (Caddy serves deploy/web there, see publish-web.sh), e.g. play.dutchpub.eu.
# Its DNS record points at this server too. Also allow it in backend.env: CORS_ORIGIN=https://<it>.
WEB_DOMAIN=play.yourname.duckdns.org
# DuckDNS: the subdomain (the part before .duckdns.org) and the token from duckdns.org.
DUCKDNS_SUBDOMAIN=yourname
DUCKDNS_TOKEN=

# MySQL (in Docker, not reachable from outside). The backend gets DB_PASSWORD, never the root one.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Backups (backup.sh). The age public key (starts with age1...): backups are encrypted with it. The
# private key is NOT on the server (keep it in your password manager): whoever takes the server
# can't read the backups.
BACKUP_AGE_RECIPIENT=
# rclone remote and bucket (set up with `rclone config`). Empty = backups stay on the server only.
BACKUP_REMOTE=b2:dutchpub-backups
# Better Stack heartbeat URL: pinged after each successful backup (no ping for a day = an alert).
BACKUP_HEARTBEAT_URL=
