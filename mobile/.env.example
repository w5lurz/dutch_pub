# Copy to .env.local (gitignored) and set your backend URL.
# localhost does NOT work from a phone or the Android emulator:
#   - physical device: your computer's LAN IP, e.g. http://192.168.1.20:3030
#   - Android emulator: http://10.0.2.2:3030
#   - iOS simulator / web: http://localhost:3030
EXPO_PUBLIC_API_URL=http://192.168.1.20:3030
