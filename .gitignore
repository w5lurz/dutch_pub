# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/backend/node_modules

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
# The Sentry token for uploading source maps (mobile/scripts/update.mjs). Here, not in mobile/.gitignore:
# that file is part of the app's fingerprint.
.env.sentry-build-plugin

npm-debug.log*
yarn-debug.log*
yarn-error.log*
# env files
.env
**/.env
!**/.env.example

# On the server: secrets and database backups (deploy/)
deploy/.env
deploy/backend.env
deploy/backups/

# Firebase config for Android push (an EAS file variable on the build servers)
/mobile/google-services.json
deploy/web/
# The web version built by deploy/publish-web.sh (not in mobile/.gitignore: that file is part of the app's native fingerprint).
mobile/dist-web/
