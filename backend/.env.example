DB_PORT=3306
DB_HOST=localhost
DB_NAME=dutch_pub
DB_USER=
DB_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional. HTTP port (default 3030; Cloud Run sets it).
# PORT=3030
# Optional. Only needed to run the Expo app in a browser (npm run web), e.g. http://localhost:8081
# CORS_ORIGIN=
# Behind a proxy (ngrok, the host's load balancer): 1 = one proxy in front, so rate limits see each phone's address.
# TRUST_PROXY=1
# Rooms at once ("The server is full" past it). Memory is the limit, ~1.2 MB per room: size it to the
# host's RAM: 512 MB ~150, 1 GB ~300 (the default), 2 GB ~800. See test/load/loadTest.js.
# MAX_ROOMS=300
# The server's public address (password reset links point here), e.g. https://dutchpub.example
# PUBLIC_URL=
# Email for password reset links (any SMTP provider; Gmail: an app password, port 587).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Dutch Pub <address@example.com>"
# Shown in the privacy policy (/privacy).
# PRIVACY_CONTACT=
# PRIVACY_OWNER=
